<div>
    <h1>Prijava na delavnice</h1>

    <!-- seznam vseh udelezencev na izbrani delavnici (to je levo) -->
    <div>
        <span>Datum:</span>
        <div id="datum_vnos">
            <input type="date"  value="2022-04-06" hidden>
            <span class="oznaka2" id="datum_value">4. 4. 2022</span>
            <button id="datum_reset">Dons</button>
        </div>
        <h2>Seznam otrok na delavnici: <span class="oznaka" id="delavnica_izbrana" hidden></span></h2>
         <!--- type="date" -->
        <!-- kle bi blo bols met tabelco -->
        <ol id="prijavljeni_seznam">
            
        </ol>
    </div>

    <!-- seznam vseh delavnic -->
    <div id="delavnice_seznam">
        <h2>Seznam delavnic:</h2>
        <ul>
            {{#each delavnice_seznam as |delavnica|}}
            <li><button class="gumb2" onclick="izberiDelavnico('{{delavnica.naziv}}')">{{delavnica.naziv}}</button></li>
            {{/each}}
        </ul>
    </div>

    <!-- polje za prijavo -->
    <div>
        <h2>Prijavi udeleženca</h2>
        <span id="prijava_response"></span>
        <div id="prijava_polje">
            <!-- <p style="color:rgba(158, 158, 158, 0.725)">!!!potrebna implementacija!!!</p> -->
            <input id="input_prijava" type="text" placeholder="išči">
            <input id="input_prijavaDel" type="text" placeholder="delavnica">
            <button onclick="prijaviUdelezenca()">Prijavi</button>
            <div>
                <span id="prijavi_ime"></span>
                <span id="prijavi_priimek"></span>
                <span id="prijavi_starost"></span>
                <span> -> </span>
                <span id="prijavi_del"></span>
            </div>

            <div>
                <ol id="udelezenci_seznam" style="float:left;"> <!-- list-style-type: none; display: inline-block; zoom:1; *display: inline; _height: 30px; -->
                    {{#each udelezenci_seznam as |udelezenec|}}
                    <li><button onclick="izberiUdelezenca('{{udelezenec.ime}}','{{udelezenec.priimek}}','{{udelezenec.starost}}')" >{{udelezenec.ime}} {{udelezenec.priimek}} ({{udelezenec.starost}})</button></li>
                    {{/each}}
                </ol>
                <ul> <!-- style="list-style-type: none; display: inline-block; zoom:1; *display: inline; _height: 30px;" -->
                    {{#each delavnice_seznam as |delavnica|}}
                    <li><button class="gumb2" onclick="izberiDelavnicoPrijava('{{delavnica.naziv}}')">{{delavnica.naziv}}</button></li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>

</div>
<script src="/js/prijava.js"></script>